#!/bin/bash
# Stub sosreport seperti RHEL 9 (sos >= 4.10, patch 0001-sosreport-binary.patch):
# binary lama hanya mencetak pesan lalu exit 1. Script harus memakai 'sos report'.
printf 'sosreport\t%s\t%s\n' "${STUB_HOST:-local}" "$*" >> "${STUB_STATE:?}/calls.log"
echo "sosreport binary is deprecated, use 'sos report' instead"
exit 1
