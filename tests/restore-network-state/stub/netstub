#!/bin/bash
# Node palsu BERSTATE untuk tests/restore-network-state (multi-call):
#   ip, iptables, iptables-save, ip6tables-save, iptables-restore,
#   ip6tables-restore, nft, sudo, systemctl, systemd-run, pcs, hostname
# State live per host di $STUB_HD/live/: ipt4, ipt6 (format iptables-save tanpa
# komentar), nft (ruleset), routes4.json, routes6.json, rules4.json, rules6.json.
# Timer systemd-run: $STUB_HD/systemd/<unit>/ (timer.active, sleeper detached).
# Cluster pcs: $STUB_STATE/cluster/{status-nodes,stonith}.
# Setiap panggilan dicatat di calls.log.
#
# Env host: FQDN, PCS_NAME, IPT_BACKEND (nf_tables|legacy), VERIFY_FAIL
# (ipt|nft), SUDO_FAIL, PCS_SLOW (detik), OFFLINE_AFTER_APPLY, DRIFT_AFTER_APPLY,
# CORRUPT_PRE (ubah file pre/ di direktori restore setelah apply), RB_NOOP
# (restore iptables ke-2 = rollback tidak berefek; menguji verifikasi rollback),
# SELINUX_SIM (di unit systemd, iptables-restore tidak membaca stdin dari file)
S="${STUB_STATE:?}"
HD="${STUB_HD:?}"
L="$HD/live"
me="${0##*/}"
printf '%s\t%s\t%s\n' "$me" "${STUB_HOST:-?}${STUB_NS:+@$STUB_NS}" "$*" >> "$S/calls.log"
BK="${IPT_BACKEND:-nf_tables}"

need_root() {
    if [[ "${STUB_ROOT:-0}" != 1 ]]; then
        echo "$me: Permission denied (you must be root)" >&2
        exit 4
    fi
}

# Efek samping setelah apply (untuk tes pengecekan/rollback)
after_apply() {
    if [[ "${OFFLINE_AFTER_APPLY:-0}" == 1 && -n "${PCS_NAME:-}" ]]; then
        sed -i -E "/^ (Online|Offline):/ s/ $PCS_NAME( |\$)/ /" "$S/cluster/status-nodes"
        sed -i -E "0,/^ Offline:/ s/^( Offline:.*)\$/\1 $PCS_NAME/" "$S/cluster/status-nodes"
        if ! grep -q "Offline:.* $PCS_NAME" "$S/cluster/status-nodes"; then
            sed -i -E "0,/^ Offline:/ s/^ Offline:/ Offline: $PCS_NAME/" "$S/cluster/status-nodes"
        fi
    fi
    # Agen mengubah aturan SEKALI (setelah apply pertama), bukan setiap restore
    if [[ "${DRIFT_AFTER_APPLY:-0}" == 1 && ! -e "$HD/drift.done" ]]; then
        touch "$HD/drift.done"
        sed -i '/^\*filter$/,/^COMMIT$/ s/^COMMIT$/-A INPUT -s 10.77.0.1\/32 -j DROP\nCOMMIT/' "$L/ipt4"
    fi
    if [[ "${CORRUPT_PRE:-0}" == 1 ]]; then
        local f
        for f in "$HD"/var/lib/osops-restore/*/pre/*; do
            [[ -f "$f" ]] && echo "# corrupted" >> "$f"
        done
    fi
    return 0
}

# ipt_replace FILE — ganti tabel di live dengan tabel dari stdin
ipt_replace() {
    local live="$1" in t
    in="$(cat)"
    while IFS= read -r t; do
        awk -v t="$t" '/^\*/ { skip = (substr($0, 2) == t) } !skip { print } /^COMMIT$/ { skip = 0 }' "$live" > "$live.new"
        awk -v t="$t" '/^\*/ { on = (substr($0, 2) == t) } on { print } /^COMMIT$/ { on = 0 }' <<< "$in" \
            | grep -v '^#' | sed -E 's/^\[[0-9]+:[0-9]+\] //; s/^(:[^ ]+ [^ ]+) \[[0-9]+:[0-9]+\]$/\1 [0:0]/' >> "$live.new"
        mv "$live.new" "$live"
    done < <(sed -n 's/^\*//p' <<< "$in")
}

ipt_check() {
    local in
    in="$(cat)"
    if [[ "${VERIFY_FAIL:-}" == ipt ]]; then echo "iptables-restore: line 4 failed" >&2; return 1; fi
    if [[ -n "$in" && "$(grep -c '^\*' <<< "$in")" != "$(grep -c '^COMMIT$' <<< "$in")" ]]; then
        echo "iptables-restore: COMMIT expected at line 9" >&2
        return 1
    fi
    return 0
}

routes_txt() {
    jq -r '.[] | ([.dst] + (if .gateway then ["via", .gateway] else [] end) + ["dev", .dev]
        + (if .protocol then ["proto", .protocol] else [] end) + (if .scope then ["scope", .scope] else [] end)
        + (if .metric != null then ["metric", (.metric | tostring)] else [] end)
        + (if .prefsrc then ["src", .prefsrc] else [] end) + (if .table then ["table", .table] else [] end)
        + (if .type and .type != "unicast" then [.type] else [] end)) | join(" ")' "$1"
}

rules_txt() {
    jq -r '.[] | "\(.priority):\t" + ([(if .src then "from " + .src + (if .srclen then "/" + (.srclen|tostring) else "" end) else "from all" end)]
        + (if .fwmark then ["fwmark", .fwmark] else [] end) + ["lookup", (.table | tostring)] | join(" "))' "$1"
}

case "$me" in
    sudo)
        [[ "${1:-}" == -n ]] && shift
        printf 'SUDO\t%s\t%s\n' "${STUB_HOST:-?}" "$*" >> "$S/calls.log"
        if [[ "${SUDO_FAIL:-0}" == 1 ]]; then echo "sudo: a password is required" >&2; exit 1; fi
        STUB_ROOT=1 exec "$@"
        ;;
    hostname)
        echo "${FQDN:-unknown.example.com}"
        ;;
    iptables)
        [[ "${1:-}" == --version ]] && { echo "iptables v1.8.10 ($BK)"; exit 0; }
        echo "iptables: unexpected call" >&2; exit 2
        ;;
    iptables-save|ip6tables-save)
        need_root
        f="$L/ipt4"; [[ "$me" == ip6tables-save ]] && f="$L/ipt6"
        tb=""; cnt=0
        while (( $# > 0 )); do
            case "$1" in -c) cnt=1; shift ;; -t) tb="$2"; shift 2 ;; *) shift ;; esac
        done
        echo "# Generated by $me v1.8.10 ($BK) on Wed Nov 11 10:00:00 2026"
        if [[ -n "$tb" ]]; then
            awk -v t="$tb" '/^\*/ { on = (substr($0, 2) == t) } on { print } /^COMMIT$/ { on = 0 }' "$f"
        elif (( cnt )); then
            sed -E 's/^-A /[0:0] -A /' "$f"
        else
            cat "$f"
        fi
        ;;
    iptables-restore|ip6tables-restore)
        [[ "${1:-}" == --version || "${1:-}" == -V ]] && { echo "$me v1.8.10 ($BK)"; exit 0; }
        need_root
        f="$L/ipt4"; [[ "$me" == ip6tables-restore ]] && f="$L/ipt6"
        # SELINUX_SIM=1: di dalam unit systemd stdin yang di-redirect dari FILE
        # tidak terbaca (seperti iptables_t/initrc_t di RHEL 9): input kosong, rc 0
        if [[ "${SELINUX_SIM:-0}" == 1 && "${STUB_IN_UNIT:-0}" == 1 && -f /dev/stdin ]]; then
            printf '%s\t%s\t%s\n' SELINUX_BLOCK "${STUB_HOST:-?}" "$me $*" >> "$S/calls.log"
            exit 0
        fi
        if [[ " $* " == *" --test "* ]]; then
            ipt_check
            exit $?
        fi
        in="$(cat)"
        ipt_check <<< "$in" || exit 1
        # RB_NOOP=1: restore ke-2 dan seterusnya (rollback) tidak mengubah apa pun
        n=$(( $(cat "$HD/restore.count" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$HD/restore.count"
        if [[ "${RB_NOOP:-0}" == 1 ]] && (( n >= 2 )); then exit 0; fi
        ipt_replace "$f" <<< "$in"
        after_apply
        ;;
    nft)
        [[ "${1:-}" == --version ]] && { echo "nftables v1.0.9 (Old Doc Yak #3)"; exit 0; }
        need_root
        case "$*" in
            "list ruleset") cat "$L/nft" ;;
            "-s list ruleset") sed -E 's/ packets [0-9]+ bytes [0-9]+//' "$L/nft" ;;
            "-c -f "*)
                f="$3"
                if [[ "${VERIFY_FAIL:-}" == nft ]]; then
                    printf '%s:4:3-60: Error: Could not process rule: No such file or directory\n\t\tip saddr 10.99.42.7 drop comment "OSOPS-RULE-MARKER-nfterr"\n' "$f" >&2
                    exit 1
                fi
                if grep -q 'xt match' "$f"; then
                    echo "$f:5:3-19: Error: unsupported xtables compat expression, use iptables-nft with this ruleset" >&2
                    exit 1
                fi ;;
            "-f "*)
                f="$2"
                if [[ "$(head -n 1 "$f")" == "flush ruleset" ]]; then
                    tail -n +2 "$f" > "$L/nft"
                else
                    cat "$f" >> "$L/nft"
                fi
                after_apply ;;
            "delete table "*)
                # Tabel iptables-nft (stub menyimpan tabel iptables di ipt4/ipt6)
                ff="$L/ipt4"; [[ "$3" == ip6 ]] && ff="$L/ipt6"
                awk -v t="$4" '/^\*/ { skip = (substr($0, 2) == t) } !skip { print } /^COMMIT$/ { skip = 0 }' "$ff" > "$ff.new" && mv "$ff.new" "$ff" ;;
            *) echo "nft: unexpected: $*" >&2; exit 2 ;;
        esac
        ;;
    ip)
        j=0 fam=4
        while (( $# > 0 )); do
            case "$1" in
                -j) j=1; shift ;;
                -4) fam=4; shift ;;
                -6) fam=6; shift ;;
                -V) echo "ip utility, iproute2-6.2.0"; exit 0 ;;
                *) break ;;
            esac
        done
        obj="$1"; sub="${2:-}"; shift 2 2>/dev/null || shift $#
        case "$obj $sub" in
            "link show") exit 0 ;;
            "netns list") exit 0 ;;
            "route show"|"rule show")
                k=routes; [[ "$obj" == rule ]] && k=rules
                f="$L/$k$fam.json"
                if [[ "$*" == "table all" || -z "$*" ]]; then
                    if (( j )); then cat "$f"; elif [[ $k == routes ]]; then routes_txt "$f"; else rules_txt "$f"; fi
                elif [[ "$1" == table && "$3" == exact ]]; then
                    jq -r --arg t "$2" --arg d "$4" '.[] | select(((.table // "main") | tostring) == $t and .dst == $d) | .dst' "$f"
                elif [[ "$1" == pref ]]; then
                    jq -r --arg p "$2" '.[] | select((.priority | tostring) == $p) | .priority' "$f"
                fi
                ;;
            "route add"|"route del")
                need_root
                f="$L/routes$fam.json"
                o='{}'
                [[ "$1" != default ]] && o="$(jq -n --arg d "$1" '{dst: $d}')"
                shift
                while (( $# > 0 )); do
                    case "$1" in
                        via)    o="$(jq --arg v "$2" '.gateway = $v' <<< "$o")"; shift 2 ;;
                        dev)    o="$(jq --arg v "$2" '.dev = $v' <<< "$o")"; shift 2 ;;
                        proto)  o="$(jq --arg v "$2" '.protocol = $v' <<< "$o")"; shift 2 ;;
                        scope)  o="$(jq --arg v "$2" '.scope = $v' <<< "$o")"; shift 2 ;;
                        metric) o="$(jq --argjson v "$2" '.metric = $v' <<< "$o")"; shift 2 ;;
                        src)    o="$(jq --arg v "$2" '.prefsrc = $v' <<< "$o")"; shift 2 ;;
                        table)  o="$(jq --arg v "$2" '.table = $v' <<< "$o")"; shift 2 ;;
                        onlink) o="$(jq '.flags = ["onlink"]' <<< "$o")"; shift ;;
                        *) echo "Error: unknown argument $1" >&2; exit 2 ;;
                    esac
                done
                o="$(jq '.flags //= []' <<< "$o")"
                # shellcheck disable=SC2016  # variabel jq
                key='((.table // "main") | tostring) == (($o.table // "main") | tostring) and .dst == $o.dst'
                if [[ "$sub" == add ]]; then
                    if jq -e --argjson o "$o" "any(.[]; $key)" "$f" >/dev/null; then echo "RTNETLINK answers: File exists" >&2; exit 2; fi
                    jq --argjson o "$o" '. + [$o]' "$f" > "$f.new" && mv "$f.new" "$f"
                else
                    jq -e --argjson o "$o" "any(.[]; $key)" "$f" >/dev/null || { echo "RTNETLINK answers: No such process" >&2; exit 2; }
                    jq --argjson o "$o" "map(select(($key) | not))" "$f" > "$f.new" && mv "$f.new" "$f"
                fi
                ;;
            "rule add"|"rule del")
                need_root
                f="$L/rules$fam.json"
                o='{}'
                while (( $# > 0 )); do
                    case "$1" in
                        priority) o="$(jq --argjson v "$2" '.priority = $v' <<< "$o")"; shift 2 ;;
                        from) o="$(jq --arg v "${2%/*}" --arg l "${2#*/}" '.src = $v | if $l != $v then .srclen = ($l | tonumber) else . end' <<< "$o")"; shift 2 ;;
                        fwmark) o="$(jq --arg v "$2" '.fwmark = $v' <<< "$o")"; shift 2 ;;
                        lookup) o="$(jq --arg v "$2" '.table = $v' <<< "$o")"; shift 2 ;;
                        *) echo "Error: unknown argument $1" >&2; exit 2 ;;
                    esac
                done
                if [[ "$sub" == add ]]; then
                    jq --argjson o "$o" '. + [$o] | sort_by(.priority)' "$f" > "$f.new" && mv "$f.new" "$f"
                else
                    jq -e --argjson o "$o" 'any(.[]; .priority == $o.priority)' "$f" >/dev/null || { echo "RTNETLINK answers: No such file or directory" >&2; exit 2; }
                    jq --argjson o "$o" 'map(select(.priority != $o.priority))' "$f" > "$f.new" && mv "$f.new" "$f"
                fi
                ;;
            *) echo "ip: unexpected: $obj $sub $*" >&2; exit 2 ;;
        esac
        ;;
    systemd-run)
        unit="" on=""
        while [[ "${1:-}" == --* ]]; do
            case "$1" in
                --unit=*) unit="${1#--unit=}" ;;
                --on-active=*) on="${1#--on-active=}"; on="${on%s}" ;;
            esac
            shift
        done
        d="$HD/systemd/$unit"
        mkdir -p "$d"
        [[ -f "$d/timer.active" ]] && { echo "Unit $unit.timer already exists." >&2; exit 1; }
        printf '%q ' "$@" > "$d/cmd"
        touch "$d/timer.active"
        # shellcheck disable=SC2016  # $1..$3 milik bash -c
        ( setsid bash -c 'echo $$ > "$2/sleeper.pid"; sleep "$1"; if [ -f "$2/timer.active" ]; then rm -f "$2/timer.active"; systemctl start "$3.service"; fi' \
            _ "$on" "$d" "$unit" < /dev/null > /dev/null 2>&1 & )
        ;;
    systemctl)
        act="$1" u="${2:-}"
        base="${u%.*}" kind="${u##*.}"
        d="$HD/systemd/$base"
        case "$act $kind" in
            "is-active timer")
                if [[ -f "$d/timer.active" ]]; then echo active; exit 0; fi
                echo inactive; exit 3 ;;
            "is-active service")
                if [[ -f "$d/service.activating" ]]; then echo activating; exit 3; fi
                echo inactive; exit 3 ;;
            "stop timer")
                rm -f "$d/timer.active"
                [[ -f "$d/sleeper.pid" ]] && kill "$(cat "$d/sleeper.pid")" 2>/dev/null
                exit 0 ;;
            "start service")
                [[ -f "$d/cmd" ]] || { echo "Unit $u not found." >&2; exit 5; }
                while [[ -f "$d/service.activating" ]]; do sleep 0.2; done
                [[ -f "$d/service.done" ]] && exit 0
                touch "$d/service.activating"
                eval "STUB_ROOT=1 STUB_IN_UNIT=1 $(cat "$d/cmd")" < /dev/null > "$d/service.log" 2>&1
                touch "$d/service.done"
                rm -f "$d/service.activating" "$d/timer.active"
                exit 0 ;;
            *) echo "systemctl: unexpected $*" >&2; exit 2 ;;
        esac
        ;;
    pcs)
        need_root
        [[ -n "${PCS_SLOW:-}" ]] && sleep "$PCS_SLOW"
        case "$*" in
            "status nodes") cat "$S/cluster/status-nodes" ;;
            "property config stonith-enabled") printf 'Cluster Properties:\n stonith-enabled: %s\n' "$(cat "$S/cluster/stonith")" ;;
            *) echo "pcs: unexpected $*" >&2; exit 2 ;;
        esac
        ;;
esac
